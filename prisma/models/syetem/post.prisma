// 岗位
model Post {
    id          String    @id @default(cuid())
    // 岗位名称
    name        String
    // 岗位编码
    code        String
    // 岗位排序
    sort        Int       @default(0)
    // 状态 1-启用 2-禁用
    status      Int       @default(1)
    // 备注
    description String?
    // 创建时间
    createdTime DateTime  @default(now())
    // 更新时间
    updatedTime DateTime  @updatedAt
    // 逻辑删除，为空表示未删除，有值表示已删除
    deletedAt   DateTime?
}
