model Dept {
    id          String    @id @default(cuid()) // 部门ID
    name        String // 部门名称
    parentId    String? // 上级部门ID
    sort        Int       @default(0) // 排序
    status      Int       @default(1) // 状态 1-启用 2-禁用
    email       String? // 部门email
    mobile      String? // 部门联系方式
    userId      String? // 部门联系人
    description String? // 备注
    createdTime DateTime  @default(now()) // 创建时间
    updatedTime DateTime  @updatedAt // 更新时间
    deletedAt   DateTime? // 逻辑删除，为空表示未删除，有值表示已删除
}
