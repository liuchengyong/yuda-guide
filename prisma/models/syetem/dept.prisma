// 部门
model Dept {
    id          String    @id @default(cuid())
    // 部门名称
    name        String
    // 上级部门ID
    parentId    String?
    // 排序
    sort        Int       @default(0)
    // 状态 1-启用 2-禁用
    status      Int       @default(1)
    // 部门email
    email       String?
    // 部门联系方式
    mobile      String?
    // 部门联系人
    userId      String?
    // 备注
    description String?
    // 创建时间
    createdTime DateTime  @default(now())
    // 更新时间
    updatedTime DateTime  @updatedAt
    // 逻辑删除，为空表示未删除，有值表示已删除
    deletedAt   DateTime?
}
